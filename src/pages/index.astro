---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStory from '../components/HeroStory.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import EmptyState from '../components/EmptyState.astro';
import { formatDate } from '../lib/format';
import { selectWindow } from '../lib/window';

const allArticles = await getCollection('articles');
const allDigests = await getCollection('digests');

// Hero + editorial intro still come from the latest non-empty digest.
// Empty stubs fall through.
const latestDigest = allDigests
  .slice()
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .find((d) => d.data.articleSlugs.length > 0);

const heroSlug = latestDigest?.data.heroSlug ?? null;
const hero = heroSlug
  ? (allArticles.find((a) => a.slug === heroSlug) ?? null)
  : null;

// Rolling ~7-day window (with min-count fallback) over every article, then
// grouped by day. The hero is pulled out of its day group so it isn't shown
// twice; days left empty by that removal are dropped.
const { flat, groups } = selectWindow(allArticles);
const dayGroups = groups
  .map((g) => ({
    date: g.date,
    articles: g.articles.filter((a) => a.slug !== heroSlug),
  }))
  .filter((g) => g.articles.length > 0);

const storyCount = flat.length; // hero is counted once (it stays in `flat`)
const description =
  storyCount > 0
    ? `Almanac — the past week in dentistry, ${storyCount} hand-picked stories.`
    : undefined;
---

<BaseLayout description={description}>
  <div class="container">
    {hero && <HeroStory article={hero} />}

    {latestDigest && (
      <p class="home__intro">{latestDigest.data.intro}</p>
    )}

    {dayGroups.length > 0 ? (
      dayGroups.map((group) => (
        <section class="home__day">
          <h2 class="home__day-head">{formatDate(group.date)}</h2>
          <ArticleGrid articles={group.articles} />
        </section>
      ))
    ) : (
      !hero && (
        <EmptyState
          title="No digest yet"
          message="The first edition lands tomorrow at 06:00 Prague."
        />
      )
    )}
  </div>
</BaseLayout>

<style>
  .home__intro {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0 0 var(--space-7);
    font-style: italic;
  }
  .home__day {
    margin-bottom: var(--space-7);
  }
  .home__day:last-child {
    margin-bottom: 0;
  }
  .home__day-head {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }
</style>
