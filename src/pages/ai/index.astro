---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import EmptyState from '../../components/EmptyState.astro';

const articles = (await getCollection('articles', (a) => a.data.section === 'ai'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="AI" description="The latest AI news, hand-picked daily.">
  <div class="container">
    <header class="section-head">
      <span class="kicker">Section</span>
      <h1>Artificial intelligence</h1>
      <p class="section-head__sub">Frontier-lab releases, research, policy, and developer tooling. Five new picks every morning.</p>
    </header>
    {articles.length > 0
      ? <ArticleGrid articles={articles} />
      : <EmptyState />
    }
  </div>
</BaseLayout>

<style>
  .section-head { margin-bottom: var(--space-7); }
  .section-head h1 { margin: var(--space-2) 0; }
  .section-head__sub {
    font-size: var(--fs-md);
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0;
  }
</style>
