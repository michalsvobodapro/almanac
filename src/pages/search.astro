---
import BaseLayout from '../layouts/BaseLayout.astro';

// Pagefind static search. The index + UI assets are generated by
// `pagefind --site dist` after `astro build` (see package.json), so they live
// at <base>/pagefind/. In local `astro dev` they don't exist yet — the page
// degrades to a friendly note.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bundle = `${base}/pagefind/`;
---

<BaseLayout title="Search" description="Search the full Almanac dentistry archive.">
  <div class="container container--narrow">
    <header class="search-head">
      <span class="kicker">Search</span>
      <h1>Search the archive</h1>
      <p class="search-head__sub">Full-text search across every story Almanac has published.</p>
    </header>

    <link rel="stylesheet" href={`${bundle}pagefind-ui.css`} />
    <div id="search" class="search-ui"></div>
    <noscript><p class="search-note">Search requires JavaScript.</p></noscript>
    <p id="search-fallback" class="search-note" hidden>
      The search index is built together with the site, so it isn't available in
      local dev — it works on the published site.
    </p>
  </div>

  <script is:inline define:vars={{ bundle }}>
    (function () {
      function showFallback() {
        var fb = document.getElementById('search-fallback');
        if (fb) fb.hidden = false;
      }
      function init() {
        if (typeof PagefindUI === 'undefined') return showFallback();
        new PagefindUI({
          element: '#search',
          bundlePath: bundle,
          showImages: false,
          showSubResults: true,
          pageSize: 8,
          resetStyles: false,
        });
      }
      var s = document.createElement('script');
      s.src = bundle + 'pagefind-ui.js';
      s.onload = init;
      s.onerror = showFallback;
      document.head.appendChild(s);
    })();
  </script>

  <style>
    .search-head { margin-bottom: var(--space-6); }
    .search-head h1 { margin: var(--space-2) 0; }
    .search-head__sub { color: var(--color-text-muted); margin: 0; }
    .search-note {
      margin-top: var(--space-5);
      color: var(--color-text-subtle);
      font-size: var(--fs-sm);
    }
    /* Theme the Pagefind UI to the editorial palette. */
    .search-ui {
      --pagefind-ui-primary: var(--color-accent);
      --pagefind-ui-text: var(--color-text);
      --pagefind-ui-background: var(--color-bg-elevated);
      --pagefind-ui-border: var(--color-rule);
      --pagefind-ui-tag: var(--color-bg-subtle);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: var(--radius-md);
      --pagefind-ui-font: var(--font-body);
    }
  </style>
</BaseLayout>
