---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { formatDate } from '../../lib/format';
import { buildArcs } from '../../lib/arcs';

const arcs = buildArcs(await getCollection('articles'));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Threads" description="Research threads Almanac is tracking across editions.">
  <div class="container">
    <header class="section-head">
      <span class="kicker">Threads</span>
      <h1>Research threads</h1>
      <p class="section-head__sub">
        Research is serial. When several stories build on the same question, Almanac
        threads them — so you can see how the evidence has moved, not just today's headline.
      </p>
    </header>

    {arcs.length > 0 ? (
      <ul class="threads" role="list">
        {arcs.map((arc) => (
          <li class="thread">
            <div class="thread__head">
              <h2 class="thread__title">
                <a href={`${base}/threads/${arc.id}/`}>{arc.label}</a>
              </h2>
              <span class="thread__count">{arc.articles.length} stories</span>
            </div>
            <div class="thread__meta">
              {arc.categories.map((c) => <CategoryBadge category={c} />)}
              <span class="thread__dates">{formatDate(arc.firstSeen)} – {formatDate(arc.lastSeen)}</span>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState
        title="No threads yet"
        message="A thread appears once two or more stories share a topic. They build up over the coming editions."
      />
    )}
  </div>
</BaseLayout>

<style>
  .section-head { margin-bottom: var(--space-7); }
  .section-head h1 { margin: var(--space-2) 0; }
  .section-head__sub { font-size: var(--fs-md); color: var(--color-text-muted); max-width: 62ch; margin: 0; }
  .threads { display: flex; flex-direction: column; gap: 0; margin: 0; padding: 0; }
  .thread {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .thread:first-child { border-top: 1px solid var(--color-rule); }
  .thread__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .thread__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    margin: 0;
    line-height: var(--lh-snug);
  }
  .thread__title a { color: var(--color-text); text-decoration: none; }
  .thread__title a:hover { color: var(--color-accent); }
  .thread__count { font-size: var(--fs-sm); color: var(--color-text-subtle); white-space: nowrap; }
  .thread__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .thread__dates { font-size: var(--fs-xs); color: var(--color-text-subtle); }
</style>
