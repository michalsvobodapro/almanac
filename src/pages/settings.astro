---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_LABELS } from '../content/config';
import sourceStatusData from '../../data/source-status.json';

interface SourceStatus { id: string; name: string; }
const sources = ((sourceStatusData as { sources?: SourceStatus[] })?.sources ?? [])
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Settings" description="Personalize your Almanac. All settings live in your browser.">
  <div class="container container--narrow">
    <header class="settings-head">
      <span class="kicker">Settings</span>
      <h1>Make it yours</h1>
      <p>Everything here is stored only in your browser. No account, no sync.</p>
    </header>

    <section class="settings-section">
      <h2>Theme</h2>
      <div class="settings-row" data-setting="theme">
        <label><input type="radio" name="theme" value="system" /> System</label>
        <label><input type="radio" name="theme" value="light" /> Light</label>
        <label><input type="radio" name="theme" value="dark" /> Dark</label>
      </div>
    </section>

    <section class="settings-section">
      <h2>Default landing page</h2>
      <p class="settings-help">When you visit the site, jump straight to a specialty.</p>
      <div class="settings-row" data-setting="landing">
        <label><input type="radio" name="landing" value="home" /> Home</label>
        {CATEGORIES.map((c) => (
          <label><input type="radio" name="landing" value={c} /> {CATEGORY_LABELS[c]}</label>
        ))}
      </div>
    </section>

    <section class="settings-section">
      <h2>Categories</h2>
      <p class="settings-help">Hide a whole specialty across the site.</p>
      <div class="settings-row" data-setting="hidden-categories">
        {CATEGORIES.map((c) => (
          <label><input type="checkbox" name="category" value={c} /> Hide {CATEGORY_LABELS[c]}</label>
        ))}
      </div>
    </section>

    <section class="settings-section">
      <h2>Sources</h2>
      <p class="settings-help">Hide individual sources from cards and grids. (They still show on /sources for transparency.)</p>
      <div class="settings-sources" data-setting="hidden-sources">
        {sources.map((s) => (
          <label class="settings-source">
            <input type="checkbox" name="source" value={s.id} />
            <span>{s.name}</span>
          </label>
        ))}
      </div>
    </section>

    <section class="settings-section">
      <h2>Density</h2>
      <div class="settings-row" data-setting="compact">
        <label><input type="checkbox" name="compact" /> Compact card spacing</label>
      </div>
    </section>

    <section class="settings-section">
      <h2>Reading</h2>
      <p class="settings-help">Stories you've already seen fade so your eye jumps to what's new. Hover a faded card to bring it back.</p>
      <div class="settings-row" data-setting="dim-read">
        <label><input type="checkbox" name="dimRead" /> Dim stories I've already read</label>
        <button type="button" id="settings-clear-read" class="settings-inline-btn">Clear read history</button>
      </div>
    </section>

    <section class="settings-section settings-section--reset">
      <button type="button" id="settings-reset" class="settings-reset">Reset to defaults</button>
    </section>
  </div>
</BaseLayout>

<script>
  const KEYS = {
    theme: 'almanac.theme',
    landing: 'almanac.landing',
    hiddenSources: 'almanac.hiddenSources',
    hiddenCategories: 'almanac.hiddenCategories',
    compact: 'almanac.compactCards',
    dimRead: 'almanac.dimRead',
    read: 'almanac.read',
  };

  function rebuildHideRules() {
    const sources = (localStorage.getItem(KEYS.hiddenSources) ?? '').split(' ').filter(Boolean);
    const cats = (localStorage.getItem(KEYS.hiddenCategories) ?? '').split(' ').filter(Boolean);
    const parts: string[] = [];
    sources.forEach((id) => parts.push(`[data-source-id="${id.replace(/"/g, '\\"')}"]{display:none!important}`));
    cats.forEach((c) => parts.push(`[data-category="${c.replace(/"/g, '\\"')}"]{display:none!important}`));
    let tag = document.getElementById('almanac-hide-rules') as HTMLStyleElement | null;
    if (!parts.length) { if (tag) tag.remove(); return; }
    if (!tag) {
      tag = document.createElement('style');
      tag.id = 'almanac-hide-rules';
      document.head.appendChild(tag);
    }
    tag.textContent = parts.join('');
  }
  const applyHiddenSources = (_: string[]) => rebuildHideRules();
  const applyHiddenCategories = (_: string[]) => rebuildHideRules();
  function applyCompact(on: boolean) {
    document.documentElement.classList.toggle('compact', on);
  }
  function applyTheme(t: string) {
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    else delete document.documentElement.dataset.theme;
  }

  const theme = localStorage.getItem(KEYS.theme) ?? 'system';
  document.querySelectorAll<HTMLInputElement>('[data-setting="theme"] input').forEach((el) => {
    el.checked = el.value === theme;
  });

  const landing = localStorage.getItem(KEYS.landing) ?? 'home';
  document.querySelectorAll<HTMLInputElement>('[data-setting="landing"] input').forEach((el) => {
    el.checked = el.value === landing;
  });

  const hiddenSources = (localStorage.getItem(KEYS.hiddenSources) ?? '').split(' ').filter(Boolean);
  document.querySelectorAll<HTMLInputElement>('[data-setting="hidden-sources"] input[name="source"]').forEach((el) => {
    el.checked = hiddenSources.includes(el.value);
  });

  const hiddenCategories = (localStorage.getItem(KEYS.hiddenCategories) ?? '').split(' ').filter(Boolean);
  document.querySelectorAll<HTMLInputElement>('[data-setting="hidden-categories"] input[name="category"]').forEach((el) => {
    el.checked = hiddenCategories.includes(el.value);
  });

  const compact = localStorage.getItem(KEYS.compact) === '1';
  const compactInput = document.querySelector<HTMLInputElement>('[data-setting="compact"] input[name="compact"]');
  if (compactInput) compactInput.checked = compact;

  // Read-dimming is ON by default — checked unless explicitly turned 'off'.
  const dimInput = document.querySelector<HTMLInputElement>('[data-setting="dim-read"] input[name="dimRead"]');
  if (dimInput) dimInput.checked = localStorage.getItem(KEYS.dimRead) !== 'off';

  document.querySelectorAll<HTMLInputElement>('[data-setting="theme"] input').forEach((el) => {
    el.addEventListener('change', () => {
      if (el.value === 'system') localStorage.removeItem(KEYS.theme);
      else localStorage.setItem(KEYS.theme, el.value);
      applyTheme(el.value);
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-setting="landing"] input').forEach((el) => {
    el.addEventListener('change', () => {
      if (el.value === 'home') localStorage.removeItem(KEYS.landing);
      else localStorage.setItem(KEYS.landing, el.value);
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-setting="hidden-sources"] input[name="source"]').forEach((el) => {
    el.addEventListener('change', () => {
      const cur = (localStorage.getItem(KEYS.hiddenSources) ?? '').split(' ').filter(Boolean);
      const next = el.checked ? [...new Set([...cur, el.value])] : cur.filter((v) => v !== el.value);
      if (next.length) localStorage.setItem(KEYS.hiddenSources, next.join(' '));
      else localStorage.removeItem(KEYS.hiddenSources);
      applyHiddenSources(next);
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-setting="hidden-categories"] input[name="category"]').forEach((el) => {
    el.addEventListener('change', () => {
      const cur = (localStorage.getItem(KEYS.hiddenCategories) ?? '').split(' ').filter(Boolean);
      const next = el.checked ? [...new Set([...cur, el.value])] : cur.filter((v) => v !== el.value);
      if (next.length) localStorage.setItem(KEYS.hiddenCategories, next.join(' '));
      else localStorage.removeItem(KEYS.hiddenCategories);
      applyHiddenCategories(next);
    });
  });

  if (compactInput) {
    compactInput.addEventListener('change', () => {
      if (compactInput.checked) localStorage.setItem(KEYS.compact, '1');
      else localStorage.removeItem(KEYS.compact);
      applyCompact(compactInput.checked);
    });
  }

  if (dimInput) {
    dimInput.addEventListener('change', () => {
      // Default is ON, so we only persist the OFF state.
      if (dimInput.checked) localStorage.removeItem(KEYS.dimRead);
      else localStorage.setItem(KEYS.dimRead, 'off');
      document.getElementById('almanac-read-rules')?.remove();
    });
  }

  document.getElementById('settings-clear-read')?.addEventListener('click', () => {
    localStorage.removeItem(KEYS.read);
    document.getElementById('almanac-read-rules')?.remove();
  });

  document.getElementById('settings-reset')?.addEventListener('click', () => {
    Object.values(KEYS).forEach((k) => localStorage.removeItem(k));
    location.reload();
  });
</script>

<style>
  .settings-head { margin-bottom: var(--space-7); }
  .settings-head h1 { margin: var(--space-2) 0; }
  .settings-head p { color: var(--color-text-muted); margin: 0; }

  .settings-section {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-rule);
  }
  .settings-section h2 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }
  .settings-help {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }
  .settings-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
  }
  .settings-row label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .settings-sources {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-4);
  }
  @media (max-width: 640px) { .settings-sources { grid-template-columns: 1fr; } }
  .settings-source {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    cursor: pointer;
    font-size: var(--fs-sm);
  }

  .settings-inline-btn {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .settings-inline-btn:hover { color: var(--color-accent); }

  .settings-section--reset { border-top: 1px solid var(--color-rule); }
  .settings-reset {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    color: var(--color-text-muted);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .settings-reset:hover { color: var(--color-error); border-color: var(--color-error); }
</style>
