---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import RelatedRail from '../../components/RelatedRail.astro';
import CiteButtons from '../../components/CiteButtons.astro';
import DateLine from '../../components/DateLine.astro';
import { readingMinutes } from '../../lib/readingTime';
import { citationVancouver, citationBibtex } from '../../lib/citation';
import { buildArcs, findArc } from '../../lib/arcs';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { data } = article;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allArticles = await getCollection('articles');
const related = data.relatedSlugs
  .map((s) => allArticles.find((a) => a.slug === s))
  .filter((a): a is NonNullable<typeof a> => a !== undefined)
  .slice(0, 3);

// Prev/next within the same day's digest — kills the article dead-end.
const allDigests = await getCollection('digests');
const digest = allDigests.find((d) => d.data.date === data.digestDate);
const ordered = digest?.data.articleSlugs ?? [];
const here = ordered.indexOf(article.slug);
const prev = here > 0 ? allArticles.find((a) => a.slug === ordered[here - 1]) ?? null : null;
const next =
  here >= 0 && here < ordered.length - 1
    ? allArticles.find((a) => a.slug === ordered[here + 1]) ?? null
    : null;

// Story-arc context: is this story part of a tracked research thread?
const arcHit = findArc(buildArcs(allArticles), article.slug);

const minutes = readingMinutes(data.summary, data.summaryDeep, data.excerptFull);
const coverHref = data.coverImage ? `${base}${data.coverImage}` : null;
const deepParas = (data.summaryDeep ?? '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const excerptParas = (data.excerptFull ?? '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
---

<BaseLayout title={data.title} description={data.summary} ogImage={coverHref ?? undefined}>
  {coverHref && (
    <div class="article-cover">
      <img src={coverHref} alt={data.coverAlt ?? ''} loading="eager" decoding="async" />
      {data.coverSourceUrl && (
        <p class="article-cover__credit">
          Image via <a href={data.coverSourceUrl} target="_blank" rel="noopener noreferrer">{data.sourceName}</a>
        </p>
      )}
    </div>
  )}

  <article class="container container--narrow" data-pagefind-body data-article-slug={article.slug}>
    <header class="article-page__head">
      <div class="article-page__meta">
        <CategoryBadge category={data.category} />
        <DateLine date={data.date} />
        <span class="article-page__readtime">{minutes} min read</span>
      </div>
      <h1 class="article-page__title">{data.title}</h1>
      {data.title !== data.originalTitle && (
        <p class="article-page__original">
          <span class="eyebrow">Original headline</span>
          <span>{data.originalTitle}</span>
        </p>
      )}
      {data.evidenceType && (
        <div class="article-page__evidence">
          <EvidenceBadge
            type={data.evidenceType}
            grade={data.evidenceGrade}
            sampleSize={data.sampleSize}
            note={data.evidenceNote}
          />
        </div>
      )}
    </header>

    <p class="article-page__summary">{data.summary}</p>

    {data.clinicalTakeaway && (
      <aside class="takeaway" lang={data.summaryLang}>
        <span class="takeaway__eyebrow">Chairside takeaway</span>
        <p class="takeaway__text">{data.clinicalTakeaway}</p>
      </aside>
    )}

    {arcHit && (
      <a class="thread-banner" href={`${base}/threads/${arcHit.arc.id}/`}>
        <span class="thread-banner__eyebrow">Part of a thread</span>
        <span class="thread-banner__label">{arcHit.arc.label}</span>
        <span class="thread-banner__pos">
          {arcHit.index + 1} of {arcHit.arc.articles.length} →
        </span>
      </a>
    )}

    {deepParas.length > 0 && (
      <div class="article-page__deep prose">
        {deepParas.map((p) => <p>{p}</p>)}
      </div>
    )}

    <div class="article-page__source">
      <SourceBadge
        sourceName={data.sourceName}
        sourceUrl={data.sourceUrl}
        lang={data.summaryLang}
      />
      <a class="article-page__link" href={data.sourceUrl} target="_blank" rel="noopener noreferrer">
        Read at source →
      </a>
    </div>

    <div class="article-page__cite">
      <CiteButtons vancouver={citationVancouver(data)} bibtex={citationBibtex(data)} />
    </div>

    {excerptParas.length > 0 && (
      <details class="article-page__excerpt">
        <summary>From the publisher's abstract</summary>
        <div class="prose">
          {excerptParas.map((p) => <p>{p}</p>)}
        </div>
      </details>
    )}

    {data.tags.length > 0 && (
      <ul class="article-page__tags" role="list">
        {data.tags.map((t) => <li>#{t}</li>)}
      </ul>
    )}

    {(prev || next) && (
      <nav class="article-page__pager" aria-label="More from this edition">
        {prev ? (
          <a class="pager pager--prev" href={`${base}/articles/${prev.slug}/`}>
            <span class="pager__dir">← Previous</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="pager pager--next" href={`${base}/articles/${next.slug}/`}>
            <span class="pager__dir">Next →</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>
    )}

    <RelatedRail articles={related} />
  </article>
</BaseLayout>

<style>
  .article-cover {
    max-width: var(--grid-max);
    margin: 0 auto var(--space-6);
    padding: 0 var(--gutter);
  }
  .article-cover img {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-rule);
    background: var(--color-bg-subtle);
  }
  .article-cover__credit {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-xs);
    color: var(--color-text-subtle);
    text-align: right;
  }
  .article-cover__credit a {
    color: inherit;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }

  .article-page__head { margin-bottom: var(--space-6); }
  .article-page__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .article-page__readtime {
    font-size: var(--fs-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.02em;
  }
  .article-page__readtime::before {
    content: '·';
    margin-right: var(--space-3);
    color: var(--color-rule-strong);
  }
  .article-page__evidence { margin-top: var(--space-4); }

  /* Chairside takeaway — restrained editorial callout, not a clinical alert. */
  .takeaway {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 5%, var(--color-bg-elevated));
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .takeaway__eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .takeaway__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
    color: var(--color-text);
  }

  /* Story-arc banner — this story is part of a tracked research thread. */
  .thread-banner {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: var(--space-5) 0;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-rule-strong);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }
  .thread-banner:hover {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 4%, transparent);
  }
  .thread-banner__eyebrow {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }
  .thread-banner__label { font-family: var(--font-display); font-weight: 600; }
  .thread-banner__pos { margin-left: auto; font-size: var(--fs-sm); color: var(--color-accent); white-space: nowrap; }
  .article-page__title {
    font-size: clamp(1.75rem, 4vw, var(--fs-3xl));
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .article-page__original {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
  .article-page__original .eyebrow { display: block; margin-bottom: 2px; }
  .article-page__summary {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--color-text);
    margin: var(--space-6) 0;
    font-weight: 400;
  }
  .article-page__deep {
    margin: var(--space-6) 0;
    color: var(--color-text);
  }
  .article-page__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .article-page__link {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .article-page__link:hover { color: var(--color-accent-hover); }
  .article-page__cite { margin: var(--space-4) 0; }
  .article-page__excerpt {
    margin: var(--space-6) 0;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    background: var(--color-bg-elevated);
  }
  .article-page__excerpt summary {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-2) 0;
  }
  .article-page__excerpt[open] summary { color: var(--color-text); }
  .article-page__excerpt .prose {
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .article-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .article-page__tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    padding: 2px 8px;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
  }

  /* Prev/next within the day's edition. */
  .article-page__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }
  .pager {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    background: var(--color-bg-elevated);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .pager:hover { border-color: var(--color-rule-strong); box-shadow: var(--shadow-sm); }
  .pager--next { text-align: right; }
  .pager__dir {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }
  .pager__title {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: var(--lh-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 560px) {
    .article-page__pager { grid-template-columns: 1fr; }
    .pager--next { text-align: left; }
  }
</style>
