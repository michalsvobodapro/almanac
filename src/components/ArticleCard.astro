---
import CategoryBadge from './CategoryBadge.astro';
import EvidenceBadge from './EvidenceBadge.astro';
import SourceBadge from './SourceBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { data } = article;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/articles/${article.slug}/`;
const coverHref = data.coverImage ? `${base}${data.coverImage}` : null;
---

<article
  class="article-card"
  data-source-id={data.sourceId}
  data-category={data.category}
>
  {coverHref ? (
    <a class="article-card__cover" href={href} aria-hidden="true" tabindex="-1">
      <img src={coverHref} alt={data.coverAlt ?? ''} loading="lazy" decoding="async" />
    </a>
  ) : (
    <span class={`article-card__band article-card__band--${data.category}`} aria-hidden="true"></span>
  )}
  <div class="article-card__body">
    <div class="article-card__head">
      <CategoryBadge category={data.category} />
      {data.evidenceType && (
        <EvidenceBadge type={data.evidenceType} grade={data.evidenceGrade} compact />
      )}
    </div>
    <h3 class="article-card__title">
      <a href={href}>{data.title}</a>
    </h3>
    <p class="article-card__summary">{data.summary}</p>
    <div class="article-card__foot">
      <SourceBadge
        sourceName={data.sourceName}
        sourceUrl={data.sourceUrl}
        lang={data.summaryLang}
      />
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-elevated);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .article-card:hover {
    border-color: var(--color-rule-strong);
    box-shadow: var(--shadow-md);
  }
  .article-card__cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-rule);
  }
  .article-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .article-card:hover .article-card__cover img { transform: scale(1.03); }

  .article-card__band {
    display: block;
    height: 4px;
    background: var(--band-color);
  }
  .article-card__band--conservative   { --band-color: var(--color-cat-conservative); }
  .article-card__band--endodontics    { --band-color: var(--color-cat-endodontics); }
  .article-card__band--periodontology { --band-color: var(--color-cat-periodontology); }
  .article-card__band--implantology   { --band-color: var(--color-cat-implantology); }
  .article-card__band--orthodontics   { --band-color: var(--color-cat-orthodontics); }
  .article-card__band--other          { --band-color: var(--color-cat-other); }

  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1;
  }
  .article-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .article-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: var(--lh-snug);
    margin: 0;
    text-wrap: balance;
  }
  .article-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .article-card__title a:hover { color: var(--color-accent); }
  .article-card__summary {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    line-height: var(--lh-base);
    margin: 0;
  }
  .article-card__foot {
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-rule);
  }
</style>
