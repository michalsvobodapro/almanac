---
import CategoryBadge from './CategoryBadge.astro';
import SourceBadge from './SourceBadge.astro';
import type { CollectionEntry } from 'astro:content';

import { CATEGORY_LABELS } from '../content/config';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { data } = article;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/articles/${article.slug}/`;
---

<article
  class="hero-story hero-story--with-cover"
  data-source-id={data.sourceId}
  data-category={data.category}
  data-slug={article.slug}
>
  <div class="hero-story__text">
    <div class="hero-story__meta">
      <span class="kicker">Today's lead</span>
      <CategoryBadge category={data.category} />
    </div>
    <h1 class="hero-story__title">
      <a href={href}>{data.title}</a>
    </h1>
    <p class="hero-story__summary">{data.summary}</p>
    <div class="hero-story__foot">
      <SourceBadge
        sourceName={data.sourceName}
        sourceUrl={data.sourceUrl}
        lang={data.summaryLang}
      />
    </div>
  </div>
  <a
    class={`hero-story__panel hero-story__panel--${data.category}`}
    href={href}
    aria-hidden="true"
    tabindex="-1"
  >
    <span class="hero-story__panel-cat">{CATEGORY_LABELS[data.category]}</span>
    <span class="hero-story__panel-mark">A</span>
  </a>
</article>

<style>
  .hero-story {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-7);
  }
  .hero-story--with-cover {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
  }
  .hero-story__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hero-story__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero-story__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, var(--fs-4xl));
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero-story__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .hero-story__title a:hover { color: var(--color-accent); }
  .hero-story__summary {
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
    line-height: var(--lh-snug);
    max-width: 60ch;
    margin: 0;
  }
  /* Branded category panel — replaces unreliable journal cover figures with a
     consistent, on-brand visual block. */
  .hero-story__panel {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule);
    background:
      radial-gradient(125% 120% at 82% 8%, color-mix(in oklab, var(--cat) 30%, var(--color-bg-elevated)) 0%, var(--color-bg-elevated) 68%);
    text-decoration: none;
  }
  .hero-story__panel::before {
    /* faint dot-grid texture */
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in oklab, var(--cat) 40%, transparent) 1.1px, transparent 1.2px);
    background-size: 22px 22px;
    opacity: 0.18;
  }
  .hero-story__panel-cat {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--cat);
  }
  .hero-story__panel-mark {
    position: absolute;
    right: -0.6rem;
    bottom: -3.2rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17rem;
    line-height: 1;
    color: color-mix(in oklab, var(--cat) 26%, transparent);
    user-select: none;
  }
  .hero-story__panel--conservative   { --cat: var(--color-cat-conservative); }
  .hero-story__panel--endodontics    { --cat: var(--color-cat-endodontics); }
  .hero-story__panel--periodontology { --cat: var(--color-cat-periodontology); }
  .hero-story__panel--implantology   { --cat: var(--color-cat-implantology); }
  .hero-story__panel--orthodontics   { --cat: var(--color-cat-orthodontics); }
  .hero-story__panel--other          { --cat: var(--color-cat-other); }
  @media (max-width: 760px) {
    .hero-story--with-cover { grid-template-columns: 1fr; }
    .hero-story__panel { order: -1; aspect-ratio: 16 / 7; }
  }
</style>
