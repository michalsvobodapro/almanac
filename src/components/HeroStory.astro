---
import CategoryBadge from './CategoryBadge.astro';
import SourceBadge from './SourceBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { data } = article;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/articles/${article.slug}/`;
---

<article
  class="hero-story"
  data-source-id={data.sourceId}
  data-category={data.category}
>
  <div class="hero-story__meta">
    <span class="kicker">Today's lead</span>
    <CategoryBadge category={data.category} />
  </div>
  <h1 class="hero-story__title">
    <a href={href}>{data.title}</a>
  </h1>
  <p class="hero-story__summary">{data.summary}</p>
  <div class="hero-story__foot">
    <SourceBadge
      sourceName={data.sourceName}
      sourceUrl={data.sourceUrl}
      lang={data.summaryLang}
    />
  </div>
</article>

<style>
  .hero-story {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-7);
  }
  .hero-story__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero-story__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, var(--fs-4xl));
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero-story__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .hero-story__title a:hover { color: var(--color-accent); }
  .hero-story__summary {
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
    line-height: var(--lh-snug);
    max-width: 60ch;
    margin: 0;
  }
</style>
