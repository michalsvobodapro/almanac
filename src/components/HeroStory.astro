---
import CategoryBadge from './CategoryBadge.astro';
import SourceBadge from './SourceBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { data } = article;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/articles/${article.slug}/`;
const coverHref = data.coverImage ? `${base}${data.coverImage}` : null;
---

<article
  class:list={['hero-story', { 'hero-story--with-cover': !!coverHref }]}
  data-source-id={data.sourceId}
  data-category={data.category}
>
  <div class="hero-story__text">
    <div class="hero-story__meta">
      <span class="kicker">Today's lead</span>
      <CategoryBadge category={data.category} />
    </div>
    <h1 class="hero-story__title">
      <a href={href}>{data.title}</a>
    </h1>
    <p class="hero-story__summary">{data.summary}</p>
    <div class="hero-story__foot">
      <SourceBadge
        sourceName={data.sourceName}
        sourceUrl={data.sourceUrl}
        lang={data.summaryLang}
      />
    </div>
  </div>
  {coverHref && (
    <a class="hero-story__cover" href={href} aria-hidden="true" tabindex="-1">
      <img src={coverHref} alt={data.coverAlt ?? ''} loading="eager" decoding="async" />
    </a>
  )}
</article>

<style>
  .hero-story {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-7) 0;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-7);
  }
  .hero-story--with-cover {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
  }
  .hero-story__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hero-story__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .hero-story__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, var(--fs-4xl));
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero-story__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .hero-story__title a:hover { color: var(--color-accent); }
  .hero-story__summary {
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
    line-height: var(--lh-snug);
    max-width: 60ch;
    margin: 0;
  }
  .hero-story__cover {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-rule);
  }
  .hero-story__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 760px) {
    .hero-story--with-cover {
      grid-template-columns: 1fr;
    }
    .hero-story__cover { order: -1; }
  }
</style>
