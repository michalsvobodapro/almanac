---
// Cycles light → dark → system. Persists in localStorage.almanac.theme.
---

<button
  class="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  data-theme-toggle
>
  <span class="theme-toggle__icon" data-icon="light" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon" data-icon="dark" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon" data-icon="system" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="4" width="20" height="14" rx="2"></rect>
      <path d="M8 21h8M12 18v3"></path>
    </svg>
  </span>
</button>

<script>
  type Theme = 'light' | 'dark' | 'system';
  const KEY = 'almanac.theme';

  function read(): Theme {
    const v = localStorage.getItem(KEY);
    return v === 'light' || v === 'dark' ? v : 'system';
  }

  function apply(t: Theme) {
    if (t === 'system') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = t;
  }

  function render(btn: HTMLElement, t: Theme) {
    btn.querySelectorAll<HTMLElement>('.theme-toggle__icon').forEach((el) => {
      el.style.display = el.dataset.icon === t ? 'inline-flex' : 'none';
    });
    btn.setAttribute('aria-label', `Theme: ${t}. Click to switch.`);
  }

  function next(t: Theme): Theme {
    return t === 'light' ? 'dark' : t === 'dark' ? 'system' : 'light';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    let t = read();
    apply(t);
    render(btn, t);
    btn.addEventListener('click', () => {
      t = next(t);
      if (t === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, t);
      apply(t);
      render(btn, t);
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .theme-toggle:hover {
    color: var(--color-text);
    background-color: var(--color-bg-subtle);
  }
  .theme-toggle__icon { display: none; }
</style>
