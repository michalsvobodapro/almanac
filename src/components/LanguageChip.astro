---
interface Props { lang: 'en' | 'cs'; }
const { lang } = Astro.props;
const label = lang.toUpperCase();
---
<span class="lang-chip" title={lang === 'en' ? 'English' : 'Czech'}>{label}</span>

<style>
  .lang-chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: 1px 5px;
    letter-spacing: 0.04em;
  }
</style>
