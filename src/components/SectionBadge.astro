---
interface Props {
  section: 'ai' | 'dentistry';
  href?: string;
}
const { section, href } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const label = section === 'ai' ? 'AI' : 'Dentistry';
const finalHref = href ?? `${base}/${section}/`;
---

<a class:list={['section-badge', `section-badge--${section}`]} href={finalHref}>{label}</a>

<style>
  .section-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    color: var(--badge-color);
    background-color: color-mix(in oklab, var(--badge-color) 12%, transparent);
    transition: background-color var(--transition-fast);
  }
  .section-badge:hover {
    background-color: color-mix(in oklab, var(--badge-color) 22%, transparent);
  }
  .section-badge--ai        { --badge-color: var(--color-section-ai); }
  .section-badge--dentistry { --badge-color: var(--color-section-dentistry); }
</style>
