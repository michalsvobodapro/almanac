---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'A daily curated brief on AI and dentistry.',
  ogImage,
} = Astro.props;

const siteName = 'Almanac';
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — AI & Dentistry`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage ?? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og-default.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={ogUrl.toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    {/* Pre-paint theme + hide-rules bootstrap — prevents FOUC */}
    <script is:inline id="almanac-prefs">
      (function () {
        try {
          var t = localStorage.getItem('almanac.theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
          if (localStorage.getItem('almanac.compactCards') === '1') {
            document.documentElement.classList.add('compact');
          }
          // Read-state dimming — fade cards already seen, before paint (no FOUC).
          if (localStorage.getItem('almanac.dimRead') !== 'off') {
            var read = (localStorage.getItem('almanac.read') || '').split(' ').filter(Boolean);
            if (read.length) {
              var sel = read.map(function (s) {
                return '[data-slug="' + s.replace(/"/g, '\\"') + '"]';
              }).join(',');
              var rs = document.createElement('style');
              rs.id = 'almanac-read-rules';
              rs.textContent = sel + '{opacity:.5}';
              document.head.appendChild(rs);
            }
          }
          var rules = [];
          (localStorage.getItem('almanac.hiddenSources') || '').split(' ').filter(Boolean).forEach(function (id) {
            rules.push('[data-source-id="' + id.replace(/"/g, '\\"') + '"]{display:none!important}');
          });
          (localStorage.getItem('almanac.hiddenCategories') || '').split(' ').filter(Boolean).forEach(function (c) {
            rules.push('[data-category="' + c.replace(/"/g, '\\"') + '"]{display:none!important}');
          });
          if (rules.length) {
            var style = document.createElement('style');
            style.id = 'almanac-hide-rules';
            style.textContent = rules.join('');
            document.head.appendChild(style);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Read-state tracking: marks the current article read on visit, and cards
        read after a short dwell in the viewport. Dimming itself is applied
        pre-paint (above) on the next load, so it stays calm within a session. */}
    <script>
      (() => {
        const KEY = 'almanac.read';
        const CAP = 500;
        const get = () => (localStorage.getItem(KEY) || '').split(' ').filter(Boolean);
        const add = (slug: string | null) => {
          if (!slug) return;
          let r = get();
          if (r.includes(slug)) return;
          r.push(slug);
          if (r.length > CAP) r = r.slice(r.length - CAP);
          localStorage.setItem(KEY, r.join(' '));
        };

        const article = document.querySelector('[data-article-slug]');
        if (article) add(article.getAttribute('data-article-slug'));

        const cards = document.querySelectorAll<HTMLElement>('[data-slug]');
        if (cards.length && 'IntersectionObserver' in window) {
          const timers = new WeakMap<Element, number>();
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                if (!timers.has(e.target)) {
                  timers.set(e.target, window.setTimeout(() => {
                    add(e.target.getAttribute('data-slug'));
                    io.unobserve(e.target);
                  }, 1200));
                }
              } else {
                const t = timers.get(e.target);
                if (t) { clearTimeout(t); timers.delete(e.target); }
              }
            }
          }, { threshold: 0.6 });
          cards.forEach((c) => io.observe(c));
        }

        // Save-for-later — toggle localStorage `almanac.saved` from any save button.
        const SKEY = 'almanac.saved';
        const savedSet = () =>
          new Set((localStorage.getItem(SKEY) || '').split(' ').filter(Boolean));
        const initial = savedSet();
        document.querySelectorAll<HTMLButtonElement>('.save-btn[data-save-slug]').forEach((btn) => {
          const slug = btn.getAttribute('data-save-slug');
          if (slug && initial.has(slug)) btn.setAttribute('aria-pressed', 'true');
          btn.addEventListener('click', (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            if (!slug) return;
            const s = savedSet();
            if (s.has(slug)) s.delete(slug);
            else s.add(slug);
            if (s.size) localStorage.setItem(SKEY, [...s].join(' '));
            else localStorage.removeItem(SKEY);
            btn.setAttribute('aria-pressed', s.has(slug) ? 'true' : 'false');
          });
        });
      })();
    </script>
  </body>
</html>
